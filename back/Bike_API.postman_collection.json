{
  "info": {
    "name": "Bike Rental API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Stations",
      "item": [
        {
          "name": "Get All Stations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Station By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stations/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stations",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Rent Bike",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bikeId\": \"1\"\n}"
            }
          },
          "response": []
        }
      ]
    }
  ]
}